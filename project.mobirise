            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "img": {
              "width": "100%",
              "transition": "all 0.6s ease-in-out"
            },
            ".link-wrap": {
              "display": "inline-block",
              "width": "fit-content"
            },
            ".img-wrapper": {
              "overflow": "hidden",
              "trasnition": "all 0.3s",
