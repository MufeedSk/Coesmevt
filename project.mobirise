          "_name": "features07",
          "_customHTML": "<section class=\"features7\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#000000\" selected condition=\"showIcon\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background3.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center\" mbr-cards=\"bootstrap\">\n\n\n            <div class=\"col-lg-4 col-md-12 md-pb\">\n                <p class=\"mbr-text mbr-semibold align-left mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-text\">What we do</p>\n\n            </div>\n\n            <div class=\"col-lg-8\">\n\n                <div class=\"row\">\n                    <div class=\"card p-3 col-12 col-md-6 col-lg-6\">\n                        <div class=\"card-wrapper\">\n\n                            <div class=\"icon-wrapper\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-paper-plane mobi-mbri\" mbr-if=\"showIcon\"></span>\n                            </div>\n                            <div class=\"card-box\">\n                                <h5 class=\"card-title mbr-regular pb-1 mbr-black mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Skill Development</h5>\n                                <p class=\"card-text mbr-regular mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".card-text\">Certified training programs in smart manufacturing and EV technologies for students, faculty, and professionals.</p>\n                            </div>\n\n                        </div>\n                    </div>\n\n\n\n                    <div class=\"card p-3 col-12 col-md-6 col-lg-6\" mbr-if=\"cardsAmount > 1\">\n\n\n                        <div class=\"card-wrapper\">\n\n                            <div class=\"icon-wrapper\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-rocket mobi-mbri\" mbr-if=\"showIcon\"></span>\n                            </div>\n                            <div class=\"card-box\">\n                                <h5 class=\"card-title mbr-regular pb-1 mbr-black mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                    Research</h5>\n                                <p class=\"card-text mbr-regular mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".card-text\">Focused R&amp;D in automation, electric mobility, and Industry 4.0 with an emphasis on indigenous solutions.</p>\n                            </div>\n\n                        </div>\n                    </div>\n\n                    <div class=\"card p-3 col-12 col-md-6 col-lg-6\" mbr-if=\"cardsAmount > 2\">\n                        <div class=\"card-wrapper\">\n\n                            <div class=\"icon-wrapper\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-idea mobi-mbri\" mbr-if=\"showIcon\"></span>\n                            </div>\n                            <div class=\"card-box\">\n                                <h5 class=\"card-title mbr-regular pb-1 mbr-black mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Innovation</h5>\n                                <p class=\"card-text mbr-regular mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".card-text\">Support for new ideas and solutions through advanced labs, fostering a culture of technological innovation.</p>\n                            </div>\n\n                        </div>\n                    </div>\n                    <div class=\"card p-3 col-12 col-md-6 col-lg-6\" mbr-if=\"cardsAmount > 3\">\n                        <div class=\"card-wrapper\">\n\n                            <div class=\"icon-wrapper\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-layers mobi-mbri\" mbr-if=\"showIcon\"></span>\n                            </div>\n                            <div class=\"card-box\">\n                                <h5 class=\"card-title mbr-regular pb-1 mbr-black mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                    Design &amp; Development</h5>\n                                <p class=\"card-text mbr-regular mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".card-text\">Development of prototypes and systems in EVs and smart manufacturing, bridging concept to application.</p>\n                            </div>\n\n                        </div>\n                    </div>\n\n                    <div class=\"card p-3 col-12 col-md-6 col-lg-6\" mbr-if=\"cardsAmount > 4\">\n                        <div class=\"card-wrapper\">\n\n                            <div class=\"icon-wrapper\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-file mobi-mbri\" mbr-if=\"showIcon\"></span>\n                            </div>\n                            <div class=\"card-box\">\n                                <h5 class=\"card-title mbr-regular pb-1 mbr-black mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Industry Consultation</h5>\n                                <p class=\"card-text mbr-regular mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".card-text\">Expert consultancy for industries to adopt advanced technologies and drive digital transformation.</p>\n                            </div>\n\n                        </div>\n                    </div>\n\n                    <div class=\"card p-3 col-12 col-md-6 col-lg-6\" mbr-if=\"cardsAmount > 5\">\n                        <div class=\"card-wrapper\">\n\n                            <div class=\"icon-wrapper\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-to-ftp mobi-mbri\" mbr-if=\"showIcon\"></span>\n                            </div>\n                            <div class=\"card-box\">\n                                <h5 class=\"card-title mbr-regular pb-1 mbr-black mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Industry 4.0</h5>\n                                <p class=\"card-text mbr-regular mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".card-text\">Promotion and implementation of Digital Twin, IIoT, and automation solutions for next-gen industrial systems</p>\n                            </div>\n\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "features07-3",
          "_isUserblock": true,
          "_sourceTheme": "levelm4",
          "_cid": "rVtYPBhYtL",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "img": {
              "width": "100%",
              "transition": "all 0.6s ease-in-out"
            },
            ".link-wrap": {
              "display": "inline-block",
              "width": "fit-content"
            },
            ".img-wrapper": {
              "overflow": "hidden",
              "trasnition": "all 0.3s",
              "transition": "all 0.3s",
              "position": "relative",
              "margin-bottom": "1.5rem"
            },
            ".card": {
              "&:hover": {
                "img": {
                  "transform": "scale(1.06)"
                },
                ".img-wrapper": {
                  "box-shadow": "0 30px 30px -20px rgba(50, 50, 50, 0.3)"
                },
                ".text-wrap": {
                  "opacity": "1"
                }
              }
            },
            ".icon-wrapper": {
              "background": "@IconsBGColor",
              "display": "flex",
              "width": "50px",
              "height": "50px",
              "justify-content": "center",
              "align-items": "center",
              "border-radius": "50%",
              "opacity": "1",
              "transition": "all 0.3s",
              "z-index": "4",
              "cursor": "pointer",
              "margin": "0 0.5rem",
              "&:hover": {
                "background": "@primaryColor",
                ".link-icon": {
                  "color": "white"
                }
              }
            },
            ".link-icon": {
              "display": "inline-block",
              "color": "@IconsColor",
              "transition": "all 0.3s",
              "font-size": "1.2rem",
              "justify-content": "center"
            },
            ".text-wrap": {
              "position": "absolute",
              "opacity": "0",
              "transition": "all 0.3s",
              "left": "50%",
              "transform": "translateX(-50%)",
              "padding": "2rem",
              "bottom": "0",
              "z-index": "2",
              "height": "100%",
              "display": "flex",
              "flex-direction": "row",
              "justify-content": "center",
              "align-items": "flex-end",
              "width": "100%"
            },
            ".mbr-text, .link-align": {
              "color": "#ffffff"
            },
            ".card-title": {
              "color": "#000000",
              "text-align": "left"
            },
            ".mbr-subtitle, .link-align": {
              "color": "#d58f76"
            },
            "@media (max-width: 767px)": {
              ".card": {
                ".text-wrap": {
                  "opacity": "1",
                  "padding": "1rem"
                }
              }
            },
            ".mbr-section-subtitle": {
              "color": "#555555",
              "text-align": "left"
            }
          },
          "_name": "team01",
          "_customHTML": "<section class=\"team1\" group=\"Team\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Show Main Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Name\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Status\" name=\"showText\" checked>\n                <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\">\n        <input type=\"color\" title=\"Icons Color\" name=\"IconsColor\" value=\"#555555\" selected condition=\"showIcons\">\n        <input type=\"color\" title=\"Icons BG Color\" name=\"IconsBGColor\" value=\"#ffffff\" selected condition=\"showIcons\">\n         <select title=\"Icons\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background3.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center\" mbr-cards=\"bootstrap\">\n            <div class=\"col-12 col-md-12\" mbr-if=\"showMainTitle\">\n\n                <h4 class=\"main-title align-center pb-3 mbr-semibold mbr-black mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".main-title\"><b>Faculty Team</b></h4>\n\n            </div>\n\n            <div class=\"card p-3 col-12 col-md-6\" mbr-class=\"{'col-lg-6': cardsAmount == '2', 'col-lg-3': cardsAmount == '4',\n                             'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"card-wrapper\">\n\n                    <div class=\"img-wrapper\">\n                        <img src=\"@PROJECT_PATH@/assets/images/saikrishna1.jpg-519x504.jpeg\" alt=\"Mobirise\">\n\n                        <div class=\"text-wrap\" mbr-if=\"showIcons\">\n                         \n                            <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 0\">\n                                <span mbr-icon class=\"link-icon socicon-twitter socicon\"></span>\n                            </div>\n                                 <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 1\">\n                                <span mbr-icon class=\"link-icon socicon-instagram socicon\"></span>\n                            </div>\n                                 <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 2\">\n                                <span mbr-icon class=\"link-icon socicon-youtube socicon\"></span>\n                            </div>\n\n                        </div>\n                    </div>\n                    <div class=\"card-box align-left\" mbr-if=\"showTitle || showText || showLink\">\n                        <h4 class=\"card-title align-left mbr-regular mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Dr. P S Sai Krishna</b><br><i style><b>Associate Professor</b></i><br>Faculty In-charge</h4>\n                        <h3 class=\"mbr-section-subtitle mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-section-subtitle\">\n                            Factory Automation Lab</h3>\n                    </div>\n\n                </div>\n            </div>\n\n            <div class=\"card p-3 col-12 col-md-6\" mbr-if=\"cardsAmount > 1\" mbr-class=\"{'col-lg-6': cardsAmount == '2', 'col-lg-3': cardsAmount == '4',\n                             'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"card-wrapper\">\n\n                     <div class=\"img-wrapper\">\n                        <img src=\"@PROJECT_PATH@/assets/images/sriram-sundar.jpg-357x410.jpeg\" alt=\"Mobirise\">\n\n                        <div class=\"text-wrap\" mbr-if=\"showIcons\">\n                         \n                            <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 0\">\n                                <span mbr-icon class=\"link-icon socicon-twitter socicon\"></span>\n                            </div>\n                                 <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 1\">\n                                <span mbr-icon class=\"link-icon socicon-instagram socicon\"></span>\n                            </div>\n                                 <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 2\">\n                                <span mbr-icon class=\"link-icon socicon-youtube socicon\"></span>\n                            </div>\n\n                        </div>\n                    </div>\n                    <div class=\"card-box align-left\" mbr-if=\"showTitle || showText || showLink\">\n                        <h4 class=\"card-title align-left mbr-regular mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Dr. Sriram Sundar</b><br><i><b>Associate Professor\n</b></i><div>Faculty In-charge</div></h4>\n                        <h3 class=\"mbr-section-subtitle mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-section-subtitle\">Simulation Test Lab Hardware</h3>\n                    </div>\n\n                </div>\n            </div>\n\n\n\n            <div class=\"card p-3 col-12 col-md-6\" mbr-if=\"cardsAmount > 2\" mbr-class=\"{'col-lg-3': cardsAmount == '4',\n                             'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"card-wrapper\">\n\n                      <div class=\"img-wrapper\">\n                        <img src=\"@PROJECT_PATH@/assets/images/0035-photo-degala-venkata-kiran.jpg-2-472x606.jpeg\" alt=\"Mobirise\">\n\n                        <div class=\"text-wrap\" mbr-if=\"showIcons\">\n                         \n                            <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 0\">\n                                <span mbr-icon class=\"link-icon socicon-twitter socicon\"></span>\n                            </div>\n                                 <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 1\">\n                                <span mbr-icon class=\"link-icon socicon-instagram socicon\"></span>\n                            </div>\n                                 <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 2\">\n                                <span mbr-icon class=\"link-icon socicon-youtube socicon\"></span>\n                            </div>\n\n                        </div>\n                    </div>\n                    <div class=\"card-box align-left\" mbr-if=\"showTitle || showText || showLink\">\n                        <h4 class=\"card-title align-left mbr-regular mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Dr. D V Kiran</b><br><i><b>Associate Professor\n</b></i><div>Faculty In-charge</div></h4>\n                        <h3 class=\"mbr-section-subtitle mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-section-subtitle\">Product Design Lab</h3>\n                    </div>\n\n                </div>\n            </div>\n\n\n\n            <div class=\"card p-3 col-12 col-md-6 col-lg-3\" mbr-if=\"cardsAmount > 3\">\n                <div class=\"card-wrapper\">\n\n                      <div class=\"img-wrapper\">\n                        <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2025-05-02-at-09.55.18-e047ca01.jpg-455x458.jpeg\" alt=\"Mobirise\">\n\n                        <div class=\"text-wrap\" mbr-if=\"showIcons\">\n                         \n                            <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 0\">\n                                <span mbr-icon class=\"link-icon socicon-twitter socicon\"></span>\n                            </div>\n                                 <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 1\">\n                                <span mbr-icon class=\"link-icon socicon-instagram socicon\"></span>\n                            </div>\n                                 <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 2\">\n                                <span mbr-icon class=\"link-icon socicon-youtube socicon\"></span>\n                            </div>\n\n                        </div>\n                    </div>\n                    <div class=\"card-box align-left\" mbr-if=\"showTitle || showText || showLink\">\n                        <h4 class=\"card-title align-left mbr-regular mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Dr. Balaji Subramanian\n</b><div><i><b>Associate Professor\n</b></i></div><div>Faculty In-charge</div></h4>\n                        <h3 class=\"mbr-section-subtitle mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-section-subtitle\">Simulation Test Lab Software</h3>\n                    </div>\n\n                </div>\n            </div>\n\n\n        </div>\n    </div>\n</section>",
