          "_name": "map01",
          "_sourceTheme": "levelm4",
          "_customHTML": "<section class=\"map1 levelm4_map1\" group=\"Maps\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"map\" title=\"Map\" name=\"googleMap\" place-id=\"<iframe src=&quot;https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3876.0630046916817!2d79.59322847598494!3d13.714633886673417!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a4d39002a66fbc1%3A0x8b119aa7d2f969b3!2sIIT%20Tirupati%20Main%20Gate!5e0!3m2!1sen!2sin!4v1746182601060!5m2!1sen!2sin&quot; width=&quot;600&quot; height=&quot;450&quot; style=&quot;border:0;&quot; allowfullscreen=&quot;&quot; loading=&quot;lazy&quot; referrerpolicy=&quot;no-referrer-when-downgrade&quot;></iframe>\" value=\"<iframe src=&quot;https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3876.0630046916817!2d79.59322847598494!3d13.714633886673417!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a4d39002a66fbc1%3A0x8b119aa7d2f969b3!2sIIT%20Tirupati%20Main%20Gate!5e0!3m2!1sen!2sin!4v1746182601060!5m2!1sen!2sin&quot; width=&quot;600&quot; height=&quot;450&quot; style=&quot;border:0;&quot; allowfullscreen=&quot;&quot; loading=&quot;lazy&quot; referrerpolicy=&quot;no-referrer-when-downgrade&quot;></iframe>\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"google-map\" mbr-map=\"googleMap\">\n    </div>\n</section>",
          "_cid": "uJVUCKG7ku",
