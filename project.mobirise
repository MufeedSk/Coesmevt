        {
          "_name": "image01",
          "_sourceTheme": "preschoolm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"image01\" group=\"Image & Video\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Card</header>\n        <input type=\"range\" inline title=\"Amount\" name=\"cardAmount\" min=\"2\" max=\"6\" step=\"1\" value=\"6\">\n        <input type=\"checkbox\" title=\"Shadow\" name=\"hasShadow\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/preschoolm5/components/_images/bg/4-bg.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/preschoolm5/components/_images/bg/1-bg.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"wrapper justify-content-center\">\n            <div class=\"left-col\">\n                <div class=\"row flex-column\">\n                    <div class=\"col-12 mb-3\">\n                        <div class=\"card\">\n                            <img src=\"@PROJECT_PATH@/assets/images/im2015010289co-300dpi-original.jpg-1783x1157.jpg\" alt=\"Mobirise\" class=\"card-img\">\n                        </div>\n                    </div>\n                    <div class=\"col-12 mb-3\" mbr-if=\"cardAmount > 2\">\n                        <div class=\"card\">\n                            <img src=\"@PROJECT_PATH@/assets/images/am-financial-visual-16to9-original.jpg-1783x1003.jpg\" alt=\"Mobirise\" class=\"card-img\">\n                        </div>\n                    </div>\n                    <div class=\"col-12 mb-3\" mbr-if=\"cardAmount > 4\">\n                        <div class=\"card\">\n                            <img src=\"@PROJECT_PATH@/assets/images/industrial-ai-factory-original.jpeg-1783x1003.jpg\" alt=\"Mobirise\" class=\"card-img\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"right-col\">\n                <div class=\"row flex-column\">\n                    <div class=\"col-12 mb-3\">\n                        <div class=\"card\">\n                            <img src=\"@PROJECT_PATH@/assets/images/im2019110082di-original.jpg-3-1249x927.jpeg\" alt=\"Mobirise\" class=\"card-img\">\n                        </div>\n                    </div>\n                    <div class=\"col-12 mb-3\" mbr-if=\"cardAmount > 3\">\n                        <div class=\"card\">\n                            <img src=\"@PROJECT_PATH@/assets/images/digital-twin.png-750x407.png\" alt=\"Mobirise\" class=\"card-img\">\n                        </div>\n                    </div>\n                    <div class=\"col-12 mb-3\" mbr-if=\"cardAmount > 5\">\n                        <div class=\"card\">\n                            <img src=\"@PROJECT_PATH@/assets/images/im2015030542co-300dpi-original1.jpg-1783x1189.jpg\" alt=\"Mobirise\" class=\"card-img\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".wrapper": {
              "display": "flex",
              "flex-wrap": "wrap",
              "@media (min-width: 992px)": {
                "& .left-col": {
                  "flex": "1 0 50%",
                  "padding-right": "12px"
                },
                "& .right-col": {
                  "flex": "1 0 50%",
                  "padding-left": "12px"
                }
              }
            },
            ".card": {
              "padding": "0",
              "background-color": "#fff",
              "overflow": "hidden",
              "& when (@hasShadow)": {
                "box-shadow": "0px 10px 20px 0px rgba(29, 29, 27, 0.2)"
              }
            },
            ".card-img": {
              "width": "100%",
              "height": "100%",
              "margin": "0",
              "object-fit": "cover",
              "border-radius": "20px"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
