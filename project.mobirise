            ".link-align": {
              "width": "100%"
            },
            ".link-wrap": {
              "display": "inline-block"
            },
            "@keyframes hover": {
              "0%": {
                "transform": "scale(1)"
              },
              "50%": {
                "transform": "scale(1.1)"
