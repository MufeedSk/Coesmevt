        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            ".link-align": {
              "width": "100%"
            },
            ".link-wrap": {
              "display": "inline-block"
            },
            ".link": {
              "position": "relative",
              "cursor": "pointer",
              "width": "fit-content",
              "letter-spacing": "1px",
              "margin-left": "80px",
              "&:after": {
                "content": "\"\"",
                "position": "absolute",
                "height": "1px",
                "width": "60px",
                "background": "currentColor",
                "top": "45%",
                "transform": "translateY(-45%)",
                "opacity": "0.8",
                "left": "-80px"
              },
              "&:before": {
                "content": "\"\"",
                "position": "absolute",
                "height": "1px",
                "width": "0",
                "transition": "all 0.4s ease-in-out",
                "background": "currentColor",
                "top": "45%",
                "transform": "translateY(-45%)",
                "left": "-80px"
              },
              "&:hover": {
                "&:before": {
                  "width": "60px"
                }
              },
              "color": "#ffffff"
            },
            ".mbr-text, .link-align": {
              "color": "#ffffff"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "H1": {
              "color": "#ffffff"
            },
            "H2": {
              "color": "#ffffff"
            }
          },
          "_name": "header01",
          "_sourceTheme": "levelm4",
          "_customHTML": "<section class=\"header1 levelm4_header1\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        \n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"15\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"15\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Sub Title\" name=\"showsubTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Link\" name=\"showLink\">\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#7f1933\">\n            <input type=\"video\" title=\"Background Video\" value=\"https://youtu.be/X6FdNV-Vx08?feature=shared\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#4f4943\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"overlay && bg.type !== 'color'\">\n        \n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container align-left\">\n        <div class=\"row\">\n            <div class=\"mbr-white col-md-12 col-lg-8\">\n                <h2 class=\"mbr-section-subtitle mbr-white mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showsubTitle\"><br><br><br><br><br><br><br><br><br><br><br>IIT Tirupati's</h2>\n                <h1 class=\"mbr-section-title mbr-bold mbr-white pb-4 mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">Center of Excellence</h1>\n                <p class=\"mbr-text pb-5 mbr-white mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .link-align\">Smart Manufacturing and Electric Vehicle Technology.</p>\n                <div class=\"link-align\" mbr-if=\"showLink\">\n                    <div class=\"link-wrap\">\n                        <h5 class=\"link mbr-semibold pb-2 mbr-black mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".link\">LEARN MORE</h5>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uJW5VWuz7O",
          "_anchor": "header01-r",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "article01",
          "_sourceTheme": "cargom5",
          "_customHTML": "<section class=\"article01 cargom5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Container BG\" name=\"container\" value=\"#f3f3f3\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/cargom5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/cargom5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-5 card\">\n                <div class=\"card-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">\n                        <b>About CoE</b></h2>\n                    <div class=\"card-wrap\">\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                The Centre of Excellence (CoE) in Smart Manufacturing (SM) and Electric Vehicle Technology (EVT) at IIT Tirupati is a premier research and innovation hub focused on advancing next-generation manufacturing and sustainable mobility. Established in 2024, the CoE aims to facilitate cutting-edge research, industry collaboration, and skill development in these transformative domains. With state-of-the-art laboratories and partnerships with leading industries, the CoE aligns with India’s national initiatives for technology development. The CoE also supports thrust areas of IIT Tirupati, including Smart Manufacturing, Energy, and Infrastructure, which contribute to India's vision for self-reliant technology growth.\n                            </p>\n                        </div>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                Get started\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-7 card\">\n                <div class=\"image-wrapper\">\n                    <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/dsc00467.jpg-2076x1168.jpg\" alt=\"Mobirise Website Builder\">\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "margin": "0 -8px",
              ".card": {
                "padding": "0 8px"
              }
            },
            ".card-wrapper": {
              "height": "100%",
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "space-between",
              "padding": "64px",
              "background-color": "@container",
              "@media (max-width: 1440px)": {
                "padding": "32px"
              },
              "@media (max-width: 992px)": {
                "padding": "24px",
                "margin-bottom": "12px"
              },
              ".mbr-section-title": {
                "margin-bottom": "64px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "24px"
                }
              },
              ".card-wrap": {
                ".text-wrapper": {
                  ".mbr-text": {
                    "margin-bottom": "24px"
                  }
                },
                ".mbr-section-btn": {
                  ".btn": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".image-wrapper": {
              "height": "100%",
              "img": {
                "height": "100%",
                "object-fit": "cover",
                "@media (max-width: 992px)": {
                  "height": "300px"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#2c2c26"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#63635d",
              "text-align": "left"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "text-align": "left"
            }
          },
          "_cid": "uK2khWAsLG",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "article01-4s"
        },
        {
          "_name": "tabs01",
          "_sourceTheme": "healthm5",
          "_customHTML": "<section class=\"tabs01 healthm5\" group=\"List\" plugins=\"mbr-tabs\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Tabs</header>\n        <select title=\"Count\" name=\"bootstrapTabs\">\n            <option value=\"1\" selected>1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Tabs Color\" value=\"#ffffff\" name=\"tabs\" selected>\n        <input type=\"color\" title=\"Active Bg\" value=\"#ffffff\" name=\"active\" selected>\n        <input type=\"color\" title=\"Border Color\" value=\"#ffffff\" name=\"border\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/healthm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/healthm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-8\">\n                <div class=\"content-wrapper\">\n                    <div class=\"tabs-wrapper\">\n                        <ul class=\"nav nav-tabs\" role=\"tablist\">\n                            <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item first mbr-fonts-style\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link show active\" role=\"tab\" data-toggle=\"tab\" href=\"#tabs01-b_tab0\" aria-selected=\"true\" data-app-placeholder=\"Type Text\"></a></li>\n                            <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                                <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" href=\"#tab2\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    Prevention\n                                </a>\n                            </li>\n                            <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                                <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" href=\"#tab3\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    Mental Health\n                                </a>\n                            </li>\n                            <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                                <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" href=\"#tab4\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    Science\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                    <div class=\"tab-content\">\n                        <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                            <div class=\"content-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" data-app-selector=\".item-title, .tabs-wrapper\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\"><b>Director's Message</b></h4>\n                                    <p class=\"item-text mbr-fonts-style\" data-app-selector=\".item-text\" mbr-if=\"showText\" mbr-theme-style=\"display-5\">\n                                        At IIT Tirupati, we are committed to fostering innovation and excellence in engineering education and research. The establishment of the Centre of Excellence in Smart Manufacturing &amp; Electric Vehicle Technologies is a testament to our dedication to advancing India's technological capabilities. This initiative aims to bridge the gap between academia and industry, promoting interdisciplinary collaboration and driving sustainable solutions for the future.\n                                    </p>\n                                </div>\n                                <div class=\"image-wrapper\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/director.jpg-1837x1799.jpeg\" alt=\"Mobirise\">\n                                </div>\n                            </div>\n                        </div>\n                        <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\n                            <div class=\"content-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" data-app-selector=\".item-title, .tabs-wrapper\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                        Recovery Techniques\n                                    </h4>\n                                    <p class=\"item-text mbr-fonts-style\" data-app-selector=\".item-text\" mbr-if=\"showText\" mbr-theme-style=\"display-4\">\n                                        Delving into strategies for preventing sports-related injuries and accelerating\n                                        recovery, this article covers topics such as proper warm-up and stretching\n                                        routines, strength and conditioning exercises, rest and recovery techniques, and\n                                        the role of physical therapy and rehabilitation.\n                                    </p>\n                                </div>\n                                <div class=\"image-wrapper\">\n                                    <img src=\"@ADDONS_PATH@/healthm5/components/_images/health/image3.jpg\" alt=\"Mobirise\">\n                                </div>\n                            </div>\n                        </div>\n                        <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\n                            <div class=\"content-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" data-app-selector=\".item-title, .tabs-wrapper\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                        Breaking the Stigma\n                                    </h4>\n                                    <p class=\"item-text mbr-fonts-style\" data-app-selector=\".item-text\" mbr-if=\"showText\" mbr-theme-style=\"display-4\">\n                                        Focusing on the often overlooked aspect of mental health in sports, this article\n                                        discusses the prevalence of mental health challenges among athletes,\n                                        destigmatizing mental health issues, coping strategies for stress and anxiety,\n                                        and the importance of seeking support and professional help when needed.\n                                    </p>\n                                </div>\n                                <div class=\"image-wrapper\">\n                                    <img src=\"@ADDONS_PATH@/healthm5/components/_images/health/image19.jpg\" alt=\"Mobirise\">\n                                </div>\n                            </div>\n                        </div>\n                        <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\n                            <div class=\"content-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" data-app-selector=\".item-title, .tabs-wrapper\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                        Sleep for Athletes\n                                    </h4>\n                                    <p class=\"item-text mbr-fonts-style\" data-app-selector=\".item-text\" mbr-if=\"showText\" mbr-theme-style=\"display-4\">\n                                        Exploring the critical role of sleep in athletic performance and recovery, this\n                                        article delves into the science behind sleep, the impact of sleep deprivation on\n                                        physical and mental health, tips for optimizing sleep quality and duration, and\n                                        strategies for managing sleep disorders.\n                                    </p>\n                                </div>\n                                <div class=\"image-wrapper\">\n                                    <img src=\"@ADDONS_PATH@/healthm5/components/_images/health/image16.jpg\" alt=\"Mobirise\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 64px",
                "@media (max-width: 992px)": {
                  "padding": "0 32px"
                },
                "@media (max-width: 768px)": {
                  "padding": "0 24px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 32px"
              },
              "@media (max-width: 768px)": {
                "padding": "0 24px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".content-wrapper": {
              ".tabs-wrapper": {
                ".nav.nav-tabs": {
                  "border": "none",
                  "padding": "0",
                  "border-radius": "0 !important",
                  "background-color": "transparent",
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  "margin-bottom": "64px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "32px"
                  },
                  ".nav-item": {
                    "padding": "0",
                    "border": "none",
                    "border-radius": "0",
                    "display": "block",
                    "margin": "8px",
                    ".nav-link": {
                      "display": "inline-flex",
                      "align-items": "center",
                      "position": "relative",
                      "padding": "10px 16px",
                      "margin-bottom": "0",
                      "color": "@tabs",
                      "border": "1px solid transparent",
                      "border-radius": "500px !important",
                      "transition": "all 0.3s ease-in-out"
                    },
                    ".nav-link.active": {
                      "background-color": "@active",
                      "border-color": "@border"
                    }
                  }
                }
              },
              ".tab-content": {
                ".tab-pane": {
                  ".content-wrap": {
                    "display": "flex",
                    "align-items": "center",
                    "@media (max-width: 992px)": {
                      "display": "block"
                    }
                  },
                  ".text-wrapper": {
                    "width": "50%",
                    "padding-right": "64px",
                    "@media (max-width: 1440px)": {
                      "padding-right": "32px"
                    },
                    "@media (max-width: 992px)": {
                      "width": "100%",
                      "padding-right": "0",
                      "margin-bottom": "32px"
                    },
                    "& when (@reverseContent)": {
                      "padding-right": "0",
                      "padding-left": "64px",
                      "@media (max-width: 1440px)": {
                        "padding-left": "32px"
                      },
                      "@media (max-width: 992px)": {
                        "padding-left": "0"
                      }
                    },
                    ".item-title": {
                      "margin-bottom": "16px"
                    },
                    ".item-text": {
                      "opacity": ".5",
                      "margin-bottom": "0"
                    }
                  },
                  ".image-wrapper": {
                    "width": "50%",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    },
                    "img": {
                      "height": "630px",
                      "object-fit": "cover",
                      "@media (max-width: 992px)": {
                        "height": "350px"
                      }
                    }
                  }
                }
              }
            },
            ".tabs-wrapper": {
              "text-align": "center"
            },
            ".item-title": {
              "color": "#18212d"
            },
            ".item-text": {
              "color": "#111111",
              "text-align": "left"
            },
            ".item-title, .tabs-wrapper": {
              "color": "#000000"
            }
          },
          "_cid": "uJVtI30jVz",
          "_anchor": "tabs01-b",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "tabs01",
          "_sourceTheme": "healthm5",
          "_customHTML": "<section class=\"tabs01 healthm5\" group=\"List\" plugins=\"mbr-tabs\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Tabs</header>\n        <select title=\"Count\" name=\"bootstrapTabs\">\n            <option value=\"1\" selected>1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Tabs Color\" value=\"#ffffff\" name=\"tabs\" selected>\n        <input type=\"color\" title=\"Active Bg\" value=\"#ffffff\" name=\"active\" selected>\n        <input type=\"color\" title=\"Border Color\" value=\"#ffffff\" name=\"border\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/healthm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/healthm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-8\">\n                <div class=\"content-wrapper\">\n                    <div class=\"tabs-wrapper\">\n                        <ul class=\"nav nav-tabs\" role=\"tablist\">\n                            <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item first mbr-fonts-style\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link show active\" role=\"tab\" data-toggle=\"tab\" href=\"#tabs01-b_tab0\" aria-selected=\"true\" data-app-placeholder=\"Type Text\"></a></li>\n                            <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                                <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" href=\"#tab2\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    Prevention\n                                </a>\n                            </li>\n                            <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                                <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" href=\"#tab3\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    Mental Health\n                                </a>\n                            </li>\n                            <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                                <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" href=\"#tab4\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    Science\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                    <div class=\"tab-content\">\n                        <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                            <div class=\"content-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" data-app-selector=\".item-title, .tabs-wrapper\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\"><b>Head's Message</b></h4>\n                                    <p class=\"item-text mbr-fonts-style\" data-app-selector=\".item-text\" mbr-if=\"showText\" mbr-theme-style=\"display-5\">\n                                        The Centre of Excellence in Smart Manufacturing &amp; Electric Vehicle Technologies at IIT Tirupati serves as a dynamic platform for research, innovation, and skill development. Our focus is on developing indigenous technologies that align with the principles of Industry 4.0 and sustainable mobility. Through collaborative efforts with industry partners and academic institutions, we aim to nurture talent and drive technological advancements that contribute to India's growth in the manufacturing and electric vehicle sectors.\n                                    </p>\n                                </div>\n                                <div class=\"image-wrapper\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/saikrishna1-540x524.jpg-2-540x524.jpeg\" alt=\"Mobirise\">\n                                </div>\n                            </div>\n                        </div>\n                        <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\n                            <div class=\"content-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" data-app-selector=\".item-title, .tabs-wrapper\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                        Recovery Techniques\n                                    </h4>\n                                    <p class=\"item-text mbr-fonts-style\" data-app-selector=\".item-text\" mbr-if=\"showText\" mbr-theme-style=\"display-4\">\n                                        Delving into strategies for preventing sports-related injuries and accelerating\n                                        recovery, this article covers topics such as proper warm-up and stretching\n                                        routines, strength and conditioning exercises, rest and recovery techniques, and\n                                        the role of physical therapy and rehabilitation.\n                                    </p>\n                                </div>\n                                <div class=\"image-wrapper\">\n                                    <img src=\"@ADDONS_PATH@/healthm5/components/_images/health/image3.jpg\" alt=\"Mobirise\">\n                                </div>\n                            </div>\n                        </div>\n                        <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\n                            <div class=\"content-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" data-app-selector=\".item-title, .tabs-wrapper\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                        Breaking the Stigma\n                                    </h4>\n                                    <p class=\"item-text mbr-fonts-style\" data-app-selector=\".item-text\" mbr-if=\"showText\" mbr-theme-style=\"display-4\">\n                                        Focusing on the often overlooked aspect of mental health in sports, this article\n                                        discusses the prevalence of mental health challenges among athletes,\n                                        destigmatizing mental health issues, coping strategies for stress and anxiety,\n                                        and the importance of seeking support and professional help when needed.\n                                    </p>\n                                </div>\n                                <div class=\"image-wrapper\">\n                                    <img src=\"@ADDONS_PATH@/healthm5/components/_images/health/image19.jpg\" alt=\"Mobirise\">\n                                </div>\n                            </div>\n                        </div>\n                        <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\n                            <div class=\"content-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" data-app-selector=\".item-title, .tabs-wrapper\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                        Sleep for Athletes\n                                    </h4>\n                                    <p class=\"item-text mbr-fonts-style\" data-app-selector=\".item-text\" mbr-if=\"showText\" mbr-theme-style=\"display-4\">\n                                        Exploring the critical role of sleep in athletic performance and recovery, this\n                                        article delves into the science behind sleep, the impact of sleep deprivation on\n                                        physical and mental health, tips for optimizing sleep quality and duration, and\n                                        strategies for managing sleep disorders.\n                                    </p>\n                                </div>\n                                <div class=\"image-wrapper\">\n                                    <img src=\"@ADDONS_PATH@/healthm5/components/_images/health/image16.jpg\" alt=\"Mobirise\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 64px",
                "@media (max-width: 992px)": {
                  "padding": "0 32px"
                },
                "@media (max-width: 768px)": {
                  "padding": "0 24px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 32px"
              },
              "@media (max-width: 768px)": {
                "padding": "0 24px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".content-wrapper": {
              ".tabs-wrapper": {
                ".nav.nav-tabs": {
                  "border": "none",
                  "padding": "0",
                  "border-radius": "0 !important",
                  "background-color": "transparent",
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  "margin-bottom": "64px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "32px"
                  },
                  ".nav-item": {
                    "padding": "0",
                    "border": "none",
                    "border-radius": "0",
                    "display": "block",
                    "margin": "8px",
                    ".nav-link": {
                      "display": "inline-flex",
                      "align-items": "center",
                      "position": "relative",
                      "padding": "10px 16px",
                      "margin-bottom": "0",
                      "color": "@tabs",
                      "border": "1px solid transparent",
                      "border-radius": "500px !important",
                      "transition": "all 0.3s ease-in-out"
                    },
                    ".nav-link.active": {
                      "background-color": "@active",
                      "border-color": "@border"
                    }
                  }
                }
              },
              ".tab-content": {
                ".tab-pane": {
                  ".content-wrap": {
                    "display": "flex",
                    "align-items": "center",
                    "@media (max-width: 992px)": {
                      "display": "block"
                    }
                  },
                  ".text-wrapper": {
                    "width": "50%",
                    "padding-right": "64px",
                    "@media (max-width: 1440px)": {
                      "padding-right": "32px"
                    },
                    "@media (max-width: 992px)": {
                      "width": "100%",
                      "padding-right": "0",
                      "margin-bottom": "32px"
                    },
                    "& when (@reverseContent)": {
                      "padding-right": "0",
                      "padding-left": "64px",
                      "@media (max-width: 1440px)": {
                        "padding-left": "32px"
                      },
                      "@media (max-width: 992px)": {
                        "padding-left": "0"
                      }
                    },
                    ".item-title": {
                      "margin-bottom": "16px"
                    },
                    ".item-text": {
                      "opacity": ".5",
                      "margin-bottom": "0"
                    }
                  },
                  ".image-wrapper": {
                    "width": "50%",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    },
                    "img": {
                      "height": "630px",
                      "object-fit": "cover",
                      "@media (max-width: 992px)": {
                        "height": "350px"
                      }
                    }
                  }
                }
              }
            },
            ".tabs-wrapper": {
              "text-align": "center"
            },
            ".item-title": {
              "color": "#18212d"
            },
            ".item-text": {
              "color": "#000000",
              "text-align": "left"
            },
            ".item-title, .tabs-wrapper": {
              "text-align": "left"
            }
          },
          "_anchor": "tabs01-c",
          "_cid": "uJVuaxWzjt",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "h4": {
              "color": "#ffffff"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "H3": {
              "color": "#950026"
            }
          },
          "_name": "info02",
          "_sourceTheme": "levelm4",
          "_customHTML": "<section group=\"Info\" class=\"info02 levelm4_info2\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        \n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"7\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Sub Title\" name=\"showsubTitle\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\">\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/img/02.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#333333\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n        \n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container align-center\">\n        <div class=\"row justify-content-center\">\n            <div class=\"mbr-black col-md-12 col-lg-10\">\n                <h4 class=\"mbr-section-subtitle mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showsubTitle\">CALL TO ACTION</h4>\n                <h3 class=\"mbr-section-title mbr-regular mbr-white pb-4 mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\"><b>CoE Laboratories</b></h3>\n                <p class=\"mbr-text pb-4 mbr-white mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Lorem ipsum dolor sit amet,\n                    consectetur adipiscing elit. Vestibulum in fermentum tellus. Etiam turpis metus, mattis vel\n                    ullamcorper sed, convallis eget tellus.</p>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">GET STARTED</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uK1UZpHKWQ",
          "_anchor": "info02-4o",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "features9",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section class=\"features9\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" xmlns=\"http://www.w3.org/1999/html\">\n    \n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" name=\"imageWidth\" title=\"Image\" min=\"3\" max=\"7\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Price\" name=\"showPrice\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentCard\">\n        <input type=\"color\" title=\"Color\" name=\"cardsBg\" value=\"#f0f0f0\" condition=\"!transparentCard\">\n        <select title=\"Columns\" name=\"columns\">\n            <option value=\"3\" selected>4</option>\n            <option value=\"4\">3</option>\n            <option value=\"6\">2</option>\n            <option value=\"12\">1</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#bed3f9\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid' : fullWidth}\">\n        \n        \n        <div class=\"item features-image active\">\n            <div class=\"item-wrapper\">\n                <div class=\"row align-items-center\">\n                    <div class=\"col-12 col-md-{{imageWidth}}\">\n                        <div class=\"image-wrapper\">\n                            <img src=\"@PROJECT_PATH@/assets/images/istock-1303047701.jpg-1164x640.jpeg\" alt=\"Mobirise Website Builder\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-md\">\n                        <div class=\"card-box\">\n                            <div class=\"row\">\n                                <div class=\"col-md\">\n                                    <h6 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                        <a href=\"page4.html\" class=\"text-info\"><b>Digital Manufacturing Robotics and Automation Lab</b></a></h6>\n                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">The Digital Manufacturing &amp; Robotics Lab at IIT Tirupati's Centre of Excellence focuses on robotic automation, digital twin simulation, and manufacturing process optimization. This lab is designed to support advanced manufacturing techniques, including virtual process validation, robotics programming, and ergonomic checks. It provides a platform for academic research, industry collaboration, and skill development in smart manufacturing.&nbsp;<br></p>\n                                </div>\n                                <div class=\"col-md-auto\" mbr-if=\"showPrice || showButtons\">\n                                    <p class=\"price mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showPrice\" data-app-selector=\".price\"><br><i><b><br></b></i><br><i><b><br></b></i><i><b>Dr. Thiyagarajan R</b></i></p>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a href=\"page4.html\" class=\"btn btn-info-outline\" data-app-placeholder=\"Type Text\">Know more</a></div>\n                                </div>\n                                <div mbr-class=\"{'col-lg-2 d-none d-lg-block' : fullWidth}\"></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div><div class=\"item features-image\">\n            <div class=\"item-wrapper\">\n                <div class=\"row align-items-center\">\n                    <div class=\"col-12 col-md-{{imageWidth}}\">\n                        <div class=\"image-wrapper\">\n                            <img src=\"@PROJECT_PATH@/assets/images/istock-872673304.jpg-1164x722.jpeg\" alt=\"Mobirise Website Builder\" data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-md\">\n                        <div class=\"card-box\">\n                            <div class=\"row\">\n                                <div class=\"col-md\">\n                                    <h6 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><a href=\"page9.html\" class=\"text-info\"><b>Electric and Autonomous Vehicle Lab</b></a></h6>\n                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                        The Electric &amp; Autonomous Vehicle Laboratory (EAVL) focuses on the development and testing of Advanced Driver Assistance Systems (ADAS) technologies. ADAS encompasses a suite of intelligent systems designed to improve vehicle safety, enhance driving comfort, and support more efficient transportation.\n                                    </p>\n                                </div>\n                                <div class=\"col-md-auto\" mbr-if=\"showPrice || showButtons\">\n                                    <p class=\"price mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showPrice\" data-app-selector=\".price\"><b><i><br></i></b><br><b><i><br></i></b><b><i>Dr. Prashanth Vooka</i></b></p>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a href=\"page9.html\" class=\"btn btn-info-outline\" data-app-placeholder=\"Type Text\">Know more</a></div>\n                                </div>\n                                <div mbr-class=\"{'col-lg-2 d-none d-lg-block' : fullWidth}\"></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div><div class=\"item features-image\">\n            <div class=\"item-wrapper\">\n                <div class=\"row align-items-center\">\n                    <div class=\"col-12 col-md-{{imageWidth}}\">\n                        <div class=\"image-wrapper\">\n                            <img src=\"@PROJECT_PATH@/assets/images/istock-1423297705.jpg-1153x649.jpeg\" alt=\"Mobirise Website Builder\" data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-md\">\n                        <div class=\"card-box\">\n                            <div class=\"row\">\n                                <div class=\"col-md\">\n                                    <h6 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><a href=\"page8.html\" class=\"text-info\"><b>Factory Automation Lab</b></a></h6>\n                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">The FA Lab is designed to provide practical exposure to industrial automation using Programmable Logic Controllers. In this lab, students learn how to program, troubleshoot, and interface PLCS with input and output devices such as sensors, motors, relays, and actuators. The lab helps develop skills in ladder logic programming, real-time process control, and system diagnostics.<br></p>\n                                </div>\n                                <div class=\"col-md-auto\" mbr-if=\"showPrice || showButtons\">\n                                    <p class=\"price mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showPrice\" data-app-selector=\".price\"><b><i><br></i></b><br><b><i>Dr. P S Sai Krishna</i></b><br></p>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a href=\"page8.html\" class=\"btn btn-info-outline\" data-app-placeholder=\"Type Text\">Know more</a></div>\n                                </div>\n                                <div mbr-class=\"{'col-lg-2 d-none d-lg-block' : fullWidth}\"></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div><div class=\"item features-image\">\n            <div class=\"item-wrapper\">\n                <div class=\"row align-items-center\">\n                    <div class=\"col-12 col-md-{{imageWidth}}\">\n                        <div class=\"image-wrapper\">\n                            <img src=\"@PROJECT_PATH@/assets/images/istock-1435901681.jpg-1153x575.jpeg\" alt=\"Mobirise Website Builder\" data-slide-to=\"4\" data-bs-slide-to=\"4\">\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-md\">\n                        <div class=\"card-box\">\n                            <div class=\"row\">\n                                <div class=\"col-md\">\n                                    <h6 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><a href=\"page11.html\" class=\"text-info\"><b>Industrial Internet Of Things Lab</b></a></h6>\n                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                        IIoT stands for the Industrial Internet of Things. It refers to using Internet of Things (IoT) technologies and applications in industrial settings. The IIoT connects industrial devices, machines, sensors, and other equipment to the internet to gather and exchange data. This connectivity allows for increased automation, improved efficiency, and enhanced data analytics in industrial processes. \n                                    </p>\n                                </div>\n                                <div class=\"col-md-auto\" mbr-if=\"showPrice || showButtons\">\n                                    <p class=\"price mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showPrice\" data-app-selector=\".price\"><b><i><br></i></b><br><b><i><br></i></b><b><i>Dr. M Nabil</i></b></p>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a href=\"page11.html\" class=\"btn btn-info-outline\" data-app-placeholder=\"Type Text\">Know more</a></div>\n                                </div>\n                                <div mbr-class=\"{'col-lg-2 d-none d-lg-block' : fullWidth}\"></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div><div class=\"item features-image\">\n            <div class=\"item-wrapper\">\n                <div class=\"row align-items-center\">\n                    <div class=\"col-12 col-md-{{imageWidth}}\">\n                        <div class=\"image-wrapper\">\n                            <img src=\"@PROJECT_PATH@/assets/images/istock-1439482487.jpg-1153x649.jpeg\" alt=\"Mobirise Website Builder\" data-slide-to=\"5\" data-bs-slide-to=\"5\">\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-md\">\n                        <div class=\"card-box\">\n                            <div class=\"row\">\n                                <div class=\"col-md\">\n                                    <h6 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><a href=\"page10.html\" class=\"text-info\"><b>Microgrid Lab</b></a></h6>\n                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                        The Microgrid Lab at IIT Tirupati focuses on renewable energy integration, smart grid management, and energy storage systems. It provides an advanced platform for real-time grid monitoring, EV-grid interaction, and blackout recovery solutions.\n                                    </p>\n                                </div>\n                                <div class=\"col-md-auto\" mbr-if=\"showPrice || showButtons\">\n                                    <p class=\"price mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showPrice\" data-app-selector=\".price\"><b><i>Dr. Vignesh V</i></b></p>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a href=\"page10.html\" class=\"btn btn-info-outline\" data-app-placeholder=\"Type Text\">Know more</a></div>\n                                </div>\n                                <div mbr-class=\"{'col-lg-2 d-none d-lg-block' : fullWidth}\"></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div><div class=\"item features-image\">\n            <div class=\"item-wrapper\">\n                <div class=\"row align-items-center\">\n                    <div class=\"col-12 col-md-{{imageWidth}}\">\n                        <div class=\"image-wrapper\">\n                            <img src=\"@PROJECT_PATH@/assets/images/im2015040586co-300dpi-original.jpg-1153x769.jpeg\" alt=\"Mobirise Website Builder\" data-slide-to=\"6\" data-bs-slide-to=\"6\">\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-md\">\n                        <div class=\"card-box\">\n                            <div class=\"row\">\n                                <div class=\"col-md\">\n                                    <h6 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><a href=\"page5.html\" class=\"text-info\"><b>Product Design Lab</b></a></h6>\n                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                        The Product Design Lab at IIT Tirupati's Centre of Excellence focuses on digital -design, simulation, and manufacturing. This lab supports the complete product development lifecycle, from conceptualization to final design for production. It enables students and professionals to work on innovative product designs and simulate advanced manufacturing techniques.\n                                    </p>\n                                </div>\n                                <div class=\"col-md-auto\" mbr-if=\"showPrice || showButtons\">\n                                    <p class=\"price mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showPrice\" data-app-selector=\".price\"><b><i><br></i></b><br><b><i>Dr. D V kiran</i></b></p>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a href=\"page5.html\" class=\"btn btn-info-outline\" data-app-placeholder=\"Type Text\">Know more</a></div>\n                                </div>\n                                <div mbr-class=\"{'col-lg-2 d-none d-lg-block' : fullWidth}\"></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div><div class=\"item features-image\">\n            <div class=\"item-wrapper\">\n                <div class=\"row align-items-center\">\n                    <div class=\"col-12 col-md-{{imageWidth}}\">\n                        <div class=\"image-wrapper\">\n                            <img src=\"@PROJECT_PATH@/assets/images/im2015030542co-300dpi-original.jpg-1-1153x769.jpeg\" alt=\"Mobirise Website Builder\" data-slide-to=\"7\" data-bs-slide-to=\"7\">\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-md\">\n                        <div class=\"card-box\">\n                            <div class=\"row\">\n                                <div class=\"col-md\">\n                                    <h6 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><a href=\"page6.html\" class=\"text-info\"><b>Simulation and Test Lab Hardware</b></a></h6>\n                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                        The Simulation &amp; Test Lab (Hardware) at IIT Tirupati's Centre of Excellence provides a high-performance platform for real-time data acquisition, vibration testing, and system diagnostics. This lab is designed to help students and researchers perform hardware-in-the-loop (HIL) testing, ensuring accurate analysis of dynamic and acoustic systems. The facility includes industry-grade sensors, actuators, and signal processing tools to deliver precise mechanical and acoustic assessments.\n                                    </p>\n                                </div>\n                                <div class=\"col-md-auto\" mbr-if=\"showPrice || showButtons\">\n                                    <p class=\"price mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showPrice\" data-app-selector=\".price\"><b><i><br></i></b><br><b><i><br></i></b><br><b><i>Dr. Sriram Sundar</i></b></p>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-info-outline\" data-app-placeholder=\"Type Text\" href=\"page6.html\">Know more</a></div>\n                                </div>\n                                <div mbr-class=\"{'col-lg-2 d-none d-lg-block' : fullWidth}\"></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div><div class=\"item features-image\">\n            <div class=\"item-wrapper\">\n                <div class=\"row align-items-center\">\n                    <div class=\"col-12 col-md-{{imageWidth}}\">\n                        <div class=\"image-wrapper\">\n                            <img src=\"@PROJECT_PATH@/assets/images/im2016060781df-c-300dpi-original.jpg-1153x1107.jpeg\" alt=\"Mobirise Website Builder\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-md\">\n                        <div class=\"card-box\">\n                            <div class=\"row\">\n                                <div class=\"col-md\">\n                                    <h6 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><a href=\"page6.html\" class=\"text-info\"><b>Simulation and Test Lab Software</b></a></h6>\n                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">The Simulation &amp; Test Lab (Software) at IIT Tirupati's Centre of Excellence specializes in multiphysics simulation and real-world system analysis. This lab enables advanced computational modeling for fluid dynamics, heat transfer, structural mechanics, electromagnetics, and acoustics. The facility provides students and researchers with tools to predict system performance and optimize engineering designs.<br></p>\n                                </div>\n                                <div class=\"col-md-auto\" mbr-if=\"showPrice || showButtons\">\n                                    <p class=\"price mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showPrice\" data-app-selector=\".price\"><br><i><b><br></b></i><br><i><b>Dr. Balaji Subramanian</b></i></p>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a href=\"page7.html\" class=\"btn btn-info-outline\" data-app-placeholder=\"Type Text\">Know more</a></div>\n                                </div>\n                                <div mbr-class=\"{'col-lg-2 d-none d-lg-block' : fullWidth}\"></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "@media (max-width: 767px)": {
              ".card-box": {
                "padding": "1rem"
              }
            },
            "@media (min-width: 768px)": {
              ".card-box": {
                "padding-right": "2rem"
              }
            },
            "@media (min-width: 992px)": {
              ".card-box": {
                "padding-left": "2rem",
                "padding-right": "4rem"
              }
            },
            ".item-wrapper": {
              "border-radius": "4px",
              "background-color": "@cardsBg",
              "& when (@transparentCard)": {
                "background-color": "transparent"
              }
            },
            ".image-wrapper img": {
              "width": "100%",
              "object-fit": "cover"
            },
            ".item:not(:nth-last-child(1))": {
              "margin-bottom": "2rem"
            }
          },
          "_cid": "uK1UHbWxCb",
          "_anchor": "features9-4n",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".card-wrapper": {
              "display": "flex"
            },
            ".mbr-iconfont": {
              "font-size": "3rem",
              "color": "@iconColor"
            },
            ".icon-wrapper": {
              "margin-right": "1.5rem",
              "display": "flex",
              "justify-content": "center",
              "border-radius": "50%"
            },
            "h4": {
              "margin": "0"
            },
            ".card-text": {
              "color": "#999999"
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".card-title": {
              "color": "#000000"
            },
            "@media (min-width: 1200px)": {
              ".mbr-text": {
                "max-width": "600px"
              }
            },
            "@media (max-width: 767px)": {
              ".card-wrapper": {
                "flex-direction": "column",
                "margin": "auto",
                "text-align": "center",
                ".icon-wrapper": {
                  "margin": "0 auto",
                  "margin-bottom": "1rem"
                }
              }
