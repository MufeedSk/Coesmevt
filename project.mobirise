        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "img": {
              "width": "100%",
              "transition": "all 0.6s ease-in-out"
            },
            ".link-wrap": {
              "display": "inline-block",
              "width": "fit-content"
            },
            ".img-wrapper": {
              "overflow": "hidden",
              "trasnition": "all 0.3s",
              "transition": "all 0.3s",
              "position": "relative",
              "margin-bottom": "1.5rem"
            },
            ".card": {
              "&:hover": {
                "img": {
                  "transform": "scale(1.06)"
                },
                ".img-wrapper": {
                  "box-shadow": "0 30px 30px -20px rgba(50, 50, 50, 0.3)"
                },
                ".text-wrap": {
                  "opacity": "1"
                }
              }
            },
            ".icon-wrapper": {
              "background": "@IconsBGColor",
              "display": "flex",
              "width": "50px",
              "height": "50px",
              "justify-content": "center",
              "align-items": "center",
              "border-radius": "50%",
              "opacity": "1",
              "transition": "all 0.3s",
              "z-index": "4",
              "cursor": "pointer",
              "margin": "0 0.5rem",
              "&:hover": {
                "background": "@primaryColor",
                ".link-icon": {
                  "color": "white"
                }
              }
            },
            ".link-icon": {
              "display": "inline-block",
              "color": "@IconsColor",
              "transition": "all 0.3s",
              "font-size": "1.2rem",
              "justify-content": "center"
            },
            ".text-wrap": {
              "position": "absolute",
              "opacity": "0",
              "transition": "all 0.3s",
              "left": "50%",
              "transform": "translateX(-50%)",
              "padding": "2rem",
              "bottom": "0",
              "z-index": "2",
              "height": "100%",
              "display": "flex",
              "flex-direction": "row",
              "justify-content": "center",
              "align-items": "flex-end",
              "width": "100%"
            },
            ".mbr-text, .link-align": {
              "color": "#ffffff"
            },
            ".card-title": {
              "color": "#000000",
              "text-align": "left"
            },
            ".mbr-subtitle, .link-align": {
              "color": "#d58f76"
            },
            "@media (max-width: 767px)": {
              ".card": {
                ".text-wrap": {
                  "opacity": "1",
                  "padding": "1rem"
                }
              }
            },
            ".mbr-section-subtitle": {
              "color": "#555555",
              "text-align": "left"
            }
          },
          "_name": "team01",
          "_customHTML": "<section class=\"team1\" group=\"Team\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"9\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Show Main Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Name\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Status\" name=\"showText\" checked>\n                <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\">\n        <input type=\"color\" title=\"Icons Color\" name=\"IconsColor\" value=\"#555555\" selected condition=\"showIcons\">\n        <input type=\"color\" title=\"Icons BG Color\" name=\"IconsBGColor\" value=\"#ffffff\" selected condition=\"showIcons\">\n         <select title=\"Icons\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background3.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center\" mbr-cards=\"bootstrap\">\n            <div class=\"col-12 col-md-12\" mbr-if=\"showMainTitle\">\n\n                <h4 class=\"main-title align-center pb-3 mbr-semibold mbr-black mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".main-title\">CoE Staff</h4>\n\n            </div>\n\n            <div class=\"card p-3 col-12 col-md-6\" mbr-class=\"{'col-lg-6': cardsAmount == '2', 'col-lg-3': cardsAmount == '4',\n                             'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"card-wrapper\">\n\n                    <div class=\"img-wrapper\">\n                        <img src=\"@PROJECT_PATH@/assets/images/picture4.png-519x518.png\" alt=\"Mobirise\">\n\n                        <div class=\"text-wrap\" mbr-if=\"showIcons\">\n                         \n                            <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 0\">\n                                <span mbr-icon class=\"link-icon socicon-twitter socicon\"></span>\n                            </div>\n                                 <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 1\">\n                                <span mbr-icon class=\"link-icon socicon-instagram socicon\"></span>\n                            </div>\n                                 <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 2\">\n                                <span mbr-icon class=\"link-icon socicon-youtube socicon\"></span>\n                            </div>\n\n                        </div>\n                    </div>\n                    <div class=\"card-box align-left\" mbr-if=\"showTitle || showText || showLink\">\n                        <h4 class=\"card-title align-left mbr-regular mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Dr. Baburaj M<br></b><i><b>Technical Officer</b></i><br>Mechanical</h4>\n                        <h3 class=\"mbr-section-subtitle mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-section-subtitle\">\n                            Mechanical Labs</h3>\n                    </div>\n\n                </div>\n            </div>\n\n            <div class=\"card p-3 col-12 col-md-6\" mbr-if=\"cardsAmount > 1\" mbr-class=\"{'col-lg-6': cardsAmount == '2', 'col-lg-3': cardsAmount == '4',\n                             'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"card-wrapper\">\n\n                     <div class=\"img-wrapper\">\n                        <img src=\"@PROJECT_PATH@/assets/images/picture5.png-519x519.png\" alt=\"Mobirise\">\n\n                        <div class=\"text-wrap\" mbr-if=\"showIcons\">\n                         \n                            <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 0\">\n                                <span mbr-icon class=\"link-icon socicon-twitter socicon\"></span>\n                            </div>\n                                 <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 1\">\n                                <span mbr-icon class=\"link-icon socicon-instagram socicon\"></span>\n                            </div>\n                                 <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 2\">\n                                <span mbr-icon class=\"link-icon socicon-youtube socicon\"></span>\n                            </div>\n\n                        </div>\n                    </div>\n                    <div class=\"card-box align-left\" mbr-if=\"showTitle || showText || showLink\">\n                        <h4 class=\"card-title align-left mbr-regular mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Mr. T Satish Kumar</b><br><b><i>Technical Officer</i></b><br><div>Electrical</div></h4>\n                        <h3 class=\"mbr-section-subtitle mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-section-subtitle\">Electrical Labs</h3>\n                    </div>\n\n                </div>\n            </div>\n\n\n\n            <div class=\"card p-3 col-12 col-md-6\" mbr-if=\"cardsAmount > 2\" mbr-class=\"{'col-lg-3': cardsAmount == '4',\n                             'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"card-wrapper\">\n\n                      <div class=\"img-wrapper\">\n                        <img src=\"@PROJECT_PATH@/assets/images/picture6.png-519x519.png\" alt=\"Mobirise\">\n\n                        <div class=\"text-wrap\" mbr-if=\"showIcons\">\n                         \n                            <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 0\">\n                                <span mbr-icon class=\"link-icon socicon-twitter socicon\"></span>\n                            </div>\n                                 <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 1\">\n                                <span mbr-icon class=\"link-icon socicon-instagram socicon\"></span>\n                            </div>\n                                 <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 2\">\n                                <span mbr-icon class=\"link-icon socicon-youtube socicon\"></span>\n                            </div>\n\n                        </div>\n                    </div>\n                    <div class=\"card-box align-left\" mbr-if=\"showTitle || showText || showLink\">\n                        <h4 class=\"card-title align-left mbr-regular mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Mr. Sai Chaitanya Pilla</b><div><b><i>Technical Superintendent</i></b></div></h4>\n                        <h3 class=\"mbr-section-subtitle mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-section-subtitle\">Simulation and Test Lab Hardware</h3>\n                    </div>\n\n                </div>\n            </div>\n\n\n\n            <div class=\"card p-3 col-12 col-md-6 col-lg-3\" mbr-if=\"cardsAmount > 3\">\n                <div class=\"card-wrapper\">\n\n                      <div class=\"img-wrapper\">\n                        <img src=\"@PROJECT_PATH@/assets/images/picture9.png-519x519.png\" alt=\"Mobirise\">\n\n                        <div class=\"text-wrap\" mbr-if=\"showIcons\">\n                         \n                            <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 0\">\n                                <span mbr-icon class=\"link-icon socicon-twitter socicon\"></span>\n                            </div>\n                                 <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 1\">\n                                <span mbr-icon class=\"link-icon socicon-instagram socicon\"></span>\n                            </div>\n                                 <div class=\"icon-wrapper\" mbr-if=\"iconsAmount > 2\">\n                                <span mbr-icon class=\"link-icon socicon-youtube socicon\"></span>\n                            </div>\n\n                        </div>\n                    </div>\n                    <div class=\"card-box align-left\" mbr-if=\"showTitle || showText || showLink\">\n                        <h4 class=\"card-title align-left mbr-regular mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Mr. Dwaraka K N</b><div><i><b>JTS</b></i></div></h4>\n                        <h3 class=\"mbr-section-subtitle mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-section-subtitle\">Factory Automation Lab</h3>\n                    </div>\n\n                </div>\n            </div>\n\n\n        </div>\n    </div>\n</section>",
