              "position": "relative",
              "margin-bottom": "1.5rem"
            },
            ".card": {
              "&:hover": {
                "img": {
                  "transform": "scale(1.06)"
                },
                ".img-wrapper": {
                  "box-shadow": "0 30px 30px -20px rgba(50, 50, 50, 0.3)"
                },
                ".text-wrap": {
                  "opacity": "1"
                }
              }
            },
            ".icon-wrapper": {
              "background": "@IconsBGColor",
              "display": "flex",
              "width": "50px",
              "height": "50px",
              "justify-content": "center",
              "align-items": "center",
              "border-radius": "50%",
              "opacity": "1",
              "transition": "all 0.3s",
              "z-index": "4",
              "cursor": "pointer",
              "margin": "0 0.5rem",
              "&:hover": {
                "background": "@primaryColor",
                ".link-icon": {
                  "color": "white"
                }
              }
            },
            ".link-icon": {
              "display": "inline-block",
              "color": "@IconsColor",
              "transition": "all 0.3s",
              "font-size": "1.2rem",
              "justify-content": "center"
            },
            ".text-wrap": {
              "position": "absolute",
              "opacity": "0",
              "transition": "all 0.3s",
              "left": "50%",
              "transform": "translateX(-50%)",
              "padding": "2rem",
              "bottom": "0",
              "z-index": "2",
              "height": "100%",
              "display": "flex",
              "flex-direction": "row",
              "justify-content": "center",
              "align-items": "flex-end",
              "width": "100%"
            },
